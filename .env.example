# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & Authentication Secrets
ADMIN_JWT_SECRET="generate_a_secure_jwt_secret_for_production"
ADMIN_INITIAL_EMAIL="admin@apexgrowth.digital"
ADMIN_INITIAL_PASSWORD="ApexGrowthAdmin2026!"
ADMIN_INITIAL_NAME="Lead Director"

# PostgreSQL Database Configuration (Cloud SQL / Managed PostgreSQL)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
DATABASE_URL=""

# Optional Server-Side Payment Provider Secrets (Configured when connecting live gateways)
PAYSTACK_SECRET_KEY=""
VITE_PAYSTACK_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
BYBIT_API_KEY=""
BYBIT_API_SECRET=""

